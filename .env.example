# Supabase — dashboard.supabase.com > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Anthropic — console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-api03-...

# Notification interne (V2-30) — webhook qui reçoit les demandes de validation
# avocat (Make / Zapier / n8n / Slack incoming webhook). Si absente, la
# notification est silencieusement ignorée — la demande reste persistée en
# base via la table validation_requests, qui reste la source de vérité.
VALIDATION_NOTIFY_WEBHOOK_URL=https://hook.eu1.make.com/xxxxxxxxxxxxxxxx

# URL absolue de l'application (server-side only) — utilisée pour construire
# le lien_dossier dans la notification webhook. Si absente, le lien est dérivé
# des headers de la requête entrante (host + x-forwarded-proto). Ne pas
# préfixer NEXT_PUBLIC_ : cette valeur reste serveur uniquement.
APP_BASE_URL=https://app.cession.fr
