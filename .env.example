# =============================================================================
# Variables OBLIGATOIRES
# =============================================================================
# Sans ces 3 variables, l'application ne démarre pas correctement et la plupart
# des fonctionnalités du tunnel (création de dossier, upload, audit, rapport,
# validation avocat) échouent.

# Supabase — dashboard.supabase.com > Project Settings > API
# URL publique du projet Supabase (visible côté browser).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Clé publique anon — utilisée par le client browser pour insert/select selon RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Clé service-role — SERVEUR UNIQUEMENT. Ne jamais préfixer NEXT_PUBLIC_.
# Utilisée par les routes API (extract-text, structured-extraction) et par le
# rendu serveur du dashboard pour bypasser la RLS sur les lectures internes.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...


# =============================================================================
# Variables OPTIONNELLES
# =============================================================================
# L'application démarre et fonctionne sans elles ; certaines fonctionnalités
# secondaires (notification webhook) sont alors inactives.

# Anthropic — console.anthropic.com
# Réservée à une future version IA (V2-32+) — NON UTILISÉE actuellement par
# le tunnel audit-first. Peut rester absente sans impact.
ANTHROPIC_API_KEY=sk-ant-api03-...

# Notification interne webhook (V2-30) — Make / Zapier / n8n / Slack.
# Optionnelle en local : si absente, la notification est silencieusement ignorée
# (console.info côté serveur, route renvoie 200, UX inchangée).
# NÉCESSAIRE EN PRODUCTION pour recevoir les notifications internes lors d'une
# nouvelle demande de validation avocat. La demande reste de toute façon
# persistée dans la table validation_requests, qui est la source de vérité.
VALIDATION_NOTIFY_WEBHOOK_URL=https://hook.eu1.make.com/xxxxxxxxxxxxxxxx

# URL absolue de l'application (V2-30) — SERVEUR UNIQUEMENT.
# Utilisée pour construire le lien_dossier dans la notification webhook.
# Si absente, le lien est dérivé des headers de la requête entrante
# (host + x-forwarded-proto). Ne pas préfixer NEXT_PUBLIC_.
APP_BASE_URL=https://app.cession.fr
